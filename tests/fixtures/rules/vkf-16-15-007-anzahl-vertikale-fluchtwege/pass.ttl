@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ifc: <https://w3id.org/ifc/IFC4_ADD2#> .
@prefix ex: <https://schema.pragmaticbim.ch/ex/> .

ex:focus a pbs:LevelContext ;
  pbs:quantity_values [
    pbs:quantity_type ifc:IfcQuantityArea ;
    pbs:quantity_value 1200.0
  ] .
ex:stair1 pbs:connection_physical_type ifc:IfcStair ;
  pbs:parent_level ex:focus .
ex:stair2 pbs:connection_physical_type ifc:IfcStair ;
  pbs:parent_level ex:focus .
