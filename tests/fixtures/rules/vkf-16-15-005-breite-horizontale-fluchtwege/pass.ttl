@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ex: <https://schema.pragmaticbim.ch/ex/> .

ex:next a pbs:Space .
ex:focus a pbs:Space ;
  pbs:escape_route_next ex:next ;
  pbs:quantity_values [
    pbs:quantity_type pbs:quantity_type_escape_route_clear_width ;
    pbs:quantity_value 1.25
  ] .
