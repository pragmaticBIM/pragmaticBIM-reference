# VKF 16-15 Ziff. 2.4.5: horizontal escape route 1.00 m < 1.20 m

@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ifc: <https://w3id.org/ifc/IFC4_ADD2#> .
@prefix ex: <https://schema.pragmaticbim.ch/ex/> .

ex:focus a pbs:Space ;
  pbs:quantity_values [
    pbs:quantity_type pbs:quantity_type_escape_route_clear_width ;
    pbs:quantity_value 1.00
  ] .
