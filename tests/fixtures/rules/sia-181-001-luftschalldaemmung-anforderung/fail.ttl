# SIA 181: airborne sound 48 dB below requirement 52 dB

@prefix pbs: <https://schema.pragmaticbim.ch/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ifc: <https://w3id.org/ifc/IFC4_ADD2#> .
@prefix ex: <https://schema.pragmaticbim.ch/ex/> .

ex:focus pbs:metadata [
    pbs:metadata_key "ePset_WallRequirement.AirborneSoundInsulationMin" ;
    pbs:metadata_value "52"
  ] ;
  pbs:performance_properties [
    pbs:property_key pbs:acoustic_property_airborne_sound_rating_db ;
    pbs:property_value_number 48
  ] .
