{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.pragmaticbim.ch/elementplan/room-type-equipment.schema.json",
  "title": "Room type equipment and openings",
  "description": "Extension of a room type configuration. equipment lists what a room of this type contains, openings how it connects to neighbouring rooms and the exterior. Both reference components; optional placement_rules state where an item belongs relative to walls, openings and other equipment.",
  "type": "object",
  "properties": {
    "equipment": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/equipment"
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opening"
      }
    }
  },
  "$defs": {
    "componentRef": {
      "type": "string",
      "pattern": "^pragmaticbim:component/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "roomTypeRef": {
      "type": "string",
      "pattern": "^pragmaticbim:room-type/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "quantity": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "object",
          "required": [
            "min"
          ],
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "default": {
              "type": "integer",
              "minimum": 0
            },
            "per": {
              "type": "object",
              "required": [
                "quantity",
                "divisor"
              ],
              "additionalProperties": false,
              "properties": {
                "quantity": {
                  "type": "string",
                  "enum": [
                    "net_floor_area",
                    "peak_occupancy"
                  ]
                },
                "divisor": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "description": "min/max bound the count. With per, the target count is ceil(value / divisor), clamped to min and max; value is the room's net floor area from its outline (falling back to NetPlannedArea) or its PeakOccupancy."
        }
      ]
    },
    "params": {
      "description": "Narrows parameters of the referenced components for this room type. Every key must exist in every listed component.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "default": {
            "type": "number",
            "minimum": 0
          },
          "min": {
            "type": "number",
            "minimum": 0
          },
          "max": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "condition": {
      "description": "Applies when every listed key matches; within a key, any one entry is enough.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "project_goal_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^pragmaticbim:project-goal-level/[a-z0-9-]+$"
          }
        },
        "scenario_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^pragmaticbim:scenario-option/[a-z0-9-]+$"
          }
        }
      }
    },
    "equipment": {
      "type": "object",
      "required": [
        "id",
        "sort_order",
        "function",
        "components",
        "quantity",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pragmaticbim:room-type-equipment/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "function": {
          "$ref": "#/$defs/equipmentFunction"
        },
        "components": {
          "description": "Allowed components. The generator picks one per item.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentRef"
          }
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "unless": {
          "$ref": "#/$defs/condition"
        },
        "placement_rules": {
          "$ref": "#/$defs/placementRules"
        },
        "comment": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ]
        }
      }
    },
    "connectsTo": {
      "oneOf": [
        {
          "description": "Neighbours from the room_relationships of the selected scenario options that lead into this room type.",
          "type": "object",
          "required": [
            "relationships"
          ],
          "additionalProperties": false,
          "properties": {
            "relationships": {
              "const": "incoming"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "room_types"
          ],
          "additionalProperties": false,
          "properties": {
            "room_types": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/roomTypeRef"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "exterior"
          ],
          "additionalProperties": false,
          "properties": {
            "exterior": {
              "const": true
            }
          }
        }
      ]
    },
    "opening": {
      "type": "object",
      "required": [
        "id",
        "sort_order",
        "function",
        "components",
        "connects_to",
        "quantity",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pragmaticbim:room-type-opening/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 1
        },
        "function": {
          "$ref": "#/$defs/openingFunction"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentRef"
          }
        },
        "connects_to": {
          "$ref": "#/$defs/connectsTo"
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "params": {
          "$ref": "#/$defs/params"
        },
        "glazing_to_floor_ratio_min": {
          "description": "Minimum glazing area as a share of the room's net floor area (daylight openings only).",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "fallback": {
          "description": "What replaces the opening when it is not possible (quantity min 0).",
          "type": "string",
          "enum": [
            "mechanical_ventilation"
          ]
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "unless": {
          "$ref": "#/$defs/condition"
        },
        "placement_rules": {
          "$ref": "#/$defs/placementRules"
        },
        "comment": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "deprecated"
          ]
        }
      }
    },
    "equipmentFunction": {
      "type": "string",
      "enum": [
        "toilet",
        "washbasin",
        "bathing",
        "kitchen",
        "dining",
        "seating",
        "sleeping",
        "storage",
        "wardrobe",
        "working",
        "laundry",
        "utility_sink",
        "turning",
        "manoeuvring",
        "meeting",
        "teaching",
        "serving",
        "display",
        "dishwashing",
        "patient_care",
        "examination",
        "lab_work",
        "hazardous_storage",
        "changing",
        "lockers",
        "urinal",
        "waiting",
        "device",
        "plant",
        "power_outlet",
        "light_switch"
      ]
    },
    "openingFunction": {
      "description": "access: door into the room; connection: open passage or door between rooms of one unit; daylight: window; outdoor_access: door to a private outdoor space.",
      "type": "string",
      "enum": [
        "access",
        "connection",
        "daylight",
        "outdoor_access"
      ]
    },
    "range": {
      "description": "Bounds in metres; at least one of min and max.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "placementTarget": {
      "description": "What a rule measures against: every item of an equipment function, every opening of an opening function, or every room edge of a kind, in the same room.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "equipment_function": {
          "$ref": "#/$defs/equipmentFunction"
        },
        "opening_function": {
          "$ref": "#/$defs/openingFunction"
        },
        "edge_kind": {
          "type": "string",
          "enum": [
            "exterior",
            "interior",
            "party_wall"
          ]
        }
      }
    },
    "placementRelation": {
      "description": "next_to: plan distance to the target within distance (with side: along the wall from that jamb of the opening). opposite: on the wall facing the target's wall. same_wall_as / not_on_wall_with: on (not on) the target's wall. distance_to: centre to centre within distance. facing: the front faces the target. elevation: underside above finished floor within value. not_in_clearance_of: stays out of the target's clearances.",
      "type": "string",
      "enum": [
        "next_to",
        "opposite",
        "same_wall_as",
        "not_on_wall_with",
        "distance_to",
        "facing",
        "elevation",
        "not_in_clearance_of"
      ]
    },
    "placementCheckRules": {
      "description": "Which fields a relation needs and allows.",
      "allOf": [
        {
          "if": {
            "properties": {
              "relation": {
                "const": "elevation"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "target"
                  ]
                },
                {
                  "required": [
                    "distance"
                  ]
                }
              ]
            }
          },
          "else": {
            "required": [
              "target"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "relation": {
                "enum": [
                  "next_to",
                  "distance_to"
                ]
              }
            }
          },
          "then": {
            "required": [
              "distance"
            ]
          },
          "else": {
            "not": {
              "required": [
                "distance"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "side"
            ]
          },
          "then": {
            "properties": {
              "relation": {
                "const": "next_to"
              },
              "target": {
                "required": [
                  "opening_function"
                ]
              }
            }
          }
        }
      ]
    },
    "placementVariant": {
      "description": "Accepted alternative to the rule it belongs to; the rule holds when it or any variant holds.",
      "type": "object",
      "required": [
        "relation"
      ],
      "additionalProperties": false,
      "properties": {
        "relation": {
          "$ref": "#/$defs/placementRelation"
        },
        "target": {
          "$ref": "#/$defs/placementTarget"
        },
        "side": {
          "$ref": "#/$defs/openingSide"
        },
        "distance": {
          "$ref": "#/$defs/range"
        },
        "value": {
          "$ref": "#/$defs/range"
        },
        "room_side": {
          "$ref": "#/$defs/roomSide"
        },
        "comment": {
          "type": "string"
        }
      },
      "$ref": "#/$defs/placementCheckRules"
    },
    "openingSide": {
      "description": "Jamb of an opening: latch_side where the leaf closes, hinge_side where it is hung (sliding doors: where the leaf parks).",
      "type": "string",
      "enum": [
        "latch_side",
        "hinge_side"
      ]
    },
    "roomSide": {
      "description": "Where the item stands: inside the room (default) or outside, in the neighbouring room behind the target opening.",
      "type": "string",
      "enum": [
        "inside",
        "outside"
      ]
    },
    "placementRule": {
      "description": "Where an item belongs in the room. The generator treats required rules as hard constraints and scores preferred rules; the checker reports both.",
      "type": "object",
      "required": [
        "id",
        "relation",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pragmaticbim:placement-rule/[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "relation": {
          "$ref": "#/$defs/placementRelation"
        },
        "target": {
          "$ref": "#/$defs/placementTarget"
        },
        "side": {
          "$ref": "#/$defs/openingSide"
        },
        "distance": {
          "$ref": "#/$defs/range"
        },
        "value": {
          "$ref": "#/$defs/range"
        },
        "room_side": {
          "$ref": "#/$defs/roomSide"
        },
        "severity": {
          "type": "string",
          "enum": [
            "required",
            "preferred"
          ]
        },
        "scope": {
          "description": "each_item (default): every item satisfies the rule. each_target: every target has at least one item that satisfies it.",
          "type": "string",
          "enum": [
            "each_item",
            "each_target"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/placementVariant"
          }
        },
        "comment": {
          "type": "string"
        }
      },
      "$ref": "#/$defs/placementCheckRules"
    },
    "placementRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/placementRule"
      }
    }
  }
}
